# The OrielOS image: Fedora bootc with the Fedora CoreOS stable kernel, NVIDIA's open
# kernel modules and driver, the KDE Plasma desktop and OrielOS's own apps.
# Build it with tools/build-image.sh, which passes the pinned inputs from image/pins.env.
# The build context is the repository root.
ARG BASE_IMAGE=scratch-must-be-set
ARG AKMODS_IMAGE=scratch-must-be-set
ARG AKMODS_NVIDIA_IMAGE=scratch-must-be-set
ARG BUILDER_IMAGE=scratch-must-be-set
# Each of these names the stage to build from. tools/build-image.sh and tools/test-apps.sh can
# give an image instead: the app-deps or os-base image CI publishes, when it was built from the
# same inputs (tools/lib/stage-inputs.sh), or the app build they have just made. The stage is
# then not built here at all.
ARG APP_DEPS_FROM=app-deps
ARG OS_BASE_FROM=os-base
ARG APPS_FROM=app-builder

FROM ${AKMODS_IMAGE} AS akmods
FROM ${AKMODS_NVIDIA_IMAGE} AS akmods-nvidia

# The app build's tools and libraries, published as ghcr.io/orielos/orielos-builder.
FROM ${BUILDER_IMAGE} AS app-deps

RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/apps-builder.sh deps

# Builds and tests OrielOS's own apps, and installs them to /out. tools/test-apps.sh builds
# only this stage. None of the build tools reach the final image.
FROM ${APP_DEPS_FROM} AS app-builder

COPY CMakeLists.txt /src/
COPY apps/ /src/apps/
COPY plasma/ /src/plasma/
COPY artwork/ /src/artwork/
COPY data/ /src/data/

RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/apps-builder.sh build

FROM ${APPS_FROM} AS apps

# The kernel, desktop, drivers and packages, published as ghcr.io/orielos/orielos-base.
FROM ${BASE_IMAGE} AS os-base

RUN --mount=type=bind,source=image/build,target=/ctx \
    --mount=type=bind,from=akmods,source=/kernel-rpms,target=/akmods/kernel-rpms \
    --mount=type=bind,from=akmods,source=/rpms,target=/akmods/rpms \
    /ctx/10-kernel.sh

RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/15-server-defaults.sh

RUN --mount=type=bind,source=image/build,target=/ctx \
    --mount=type=bind,source=image/packages,target=/packages \
    /ctx/20-desktop.sh

RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/25-store.sh

# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/26-shortcuts.sh

# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    --mount=type=bind,source=plasma/shell,target=/shell \
    /ctx/27-shell.sh

# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    --mount=type=bind,source=image/sddm/orielos,target=/sddm \
    /ctx/28-sign-in.sh

# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/29-quick-sign-in.sh

RUN --mount=type=bind,source=image/build,target=/ctx \
    --mount=type=bind,source=image/keys,target=/keys \
    --mount=type=bind,from=akmods-nvidia,source=/rpms,target=/akmods-nvidia/rpms \
    /ctx/30-nvidia.sh

RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/40-apps.sh

# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/41-first-run.sh

# The system pieces games need. umu-launcher's RPM is pinned, with its digest, in image/pins.env.
ARG UMU_LAUNCHER_RPM=must-be-set
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/45-gaming.sh "${UMU_LAUNCHER_RPM}"

# Each feature script is its own layer on purpose, so a failure shows which step broke.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/80-repos.sh

# Static configuration and the apps go in on top of the OS base, so changing them does not
# rebuild its package layers.
FROM ${OS_BASE_FROM}

COPY image/system/usr/ /usr/
COPY image/system/etc/ /etc/
COPY --from=apps /out/usr/ /usr/
# Apps install their XDG autostart entries to /etc/xdg/autostart, which Plasma reads at login.
COPY --from=apps /out/etc/ /etc/
# Settings' Update page shows what's new in the running version from OrielOS's changelog.
COPY CHANGELOG.md /usr/share/doc/orielos/CHANGELOG.md

# The module and driver check runs once every package is installed. It is its own layer, so a
# failure names the step, and it has image/ mounted to read the allowed signers.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image,target=/image \
    /image/build/85-check-modules.sh

# Updates must be signed with OrielOS's key, once that key is in image/keys.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/keys,target=/keys \
    --mount=type=bind,source=image/build,target=/ctx \
    /ctx/88-signing.sh

# The boot security check makes sure every boot will meet the anti-cheat requirements.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/86-check-boot-security.sh

# The final step is its own layer for the same reason.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    /ctx/90-finalise.sh

# The version comes last. Every RUN after an ARG sees it, so declaring it earlier would make
# builds of the same commit with another version rebuild every layer; here they differ only
# in this last layer and the labels.
ARG IMAGE_VERSION=must-be-set

# Refuse to build an unversioned image, record the version for orielos-update and the Settings
# app, and put it in os-release, which the boot menu's entries are named from, and in a kernel
# argument that keeps each build's boot entries apart.
# hadolint ignore=DL3059
RUN --mount=type=bind,source=image/build,target=/ctx \
    [ "${IMAGE_VERSION}" != "must-be-set" ] || { echo "error: IMAGE_VERSION is not set" >&2; exit 1; } && \
    mkdir -p /usr/lib/orielos && \
    printf 'VERSION=%s\n' "${IMAGE_VERSION}" >/usr/lib/orielos/build-info && \
    /ctx/95-version.sh "${IMAGE_VERSION}"

LABEL org.opencontainers.image.title="OrielOS" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.source="https://github.com/OrielOS/OrielOS" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.description="A familiar Linux desktop, tuned for gaming and development. Free and open source." \
      containers.bootc="1"
