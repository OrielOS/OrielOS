# OrielOS's glass: a strong blur behind the taskbar and pop-ups, as Sill draws them, with a little
# noise so it doesn't band. A user's own blur settings in Settings still win.
[Effect-blur]
BlurStrength=12
NoiseStrength=4

[Plugins]
blurEnabled=true

# OrielOS's window frames: Sill's flat title bar with the app's icon and title, and minimise,
# maximise and close on the right.
[org.kde.kdecoration2]
library=org.orielos.decoration
theme=
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

# Alt+Tab as Windows shows it: OrielOS's switcher, thumbnails over the dimmed screen, without
# bringing each window forward in turn. Only this desktop's windows, as in Windows.
[TabBox]
LayoutName=org.orielos.switcher
HighlightWindows=false
DesktopMode=1
