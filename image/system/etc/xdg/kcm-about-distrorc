# OrielOS: About this System takes its logo from os-release (LOGO=orielos-logo-icon) and shows the
# whole OrielOS version, such as v0.0.7, not Fedora's release. This replaces Fedora's KDE
# settings, which point the page at Fedora's logo; LogoPath must stay unset for os-release to count.
[General]
UseOSReleaseVersion=true
