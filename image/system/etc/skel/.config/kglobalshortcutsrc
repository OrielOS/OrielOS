# OrielOS's Windows shortcuts for KWin, copied to every new user's ~/.config, where kglobalaccel
# keeps each user's shortcuts. Each value is the active shortcut, Plasma's default and the
# action's name; "none" means no shortcut, and \t separates two shortcuts. Shortcuts that are
# not listed here keep Plasma's defaults. Close Window gives Alt+F4 to OrielOS's Close or shut down
# KWin script, which closes the window in use or, on the desktop, offers to shut down; Maximise and
# Minimise give Win+Up and Win+Down to OrielOS's Window shortcuts script, which maximises, restores,
# minimises and snaps to quarters as Windows does. Alt+Space opens the window menu, and Win+Shift+Up
# stretches a window to the screen's full height.
[kwin]
Window Close=none,Alt+F4,Close Window
Overview=Meta+Tab\tMeta+W,Meta+W,Toggle Overview
Walk Through Windows=Alt+Tab,Alt+Tab\tMeta+Tab,Walk Through Windows
Walk Through Windows (Reverse)=Alt+Shift+Tab,Alt+Shift+Tab\tMeta+Shift+Tab,Walk Through Windows (Reverse)
Window Maximize=Meta+PgUp,Meta+PgUp,Maximize Window
Window Maximize Vertical=Meta+Shift+Up,none,Maximize Window Vertically
Window Minimize=Meta+PgDown,Meta+PgDown,Minimize Window
Window Operations Menu=Alt+Space\tAlt+F3,Alt+F3,Window Menu
Window Quick Tile Bottom=none,Meta+Down,Quick Tile Window to the Bottom
Window Quick Tile Top=none,Meta+Up,Quick Tile Window to the Top

# Ctrl+Esc opens Start, as in Windows, next to the Windows key and Plasma's Alt+F1.
[plasmashell]
activate application launcher=Meta\tAlt+F1\tCtrl+Esc,Meta\tAlt+F1,Activate Application Launcher
