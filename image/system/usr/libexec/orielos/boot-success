#!/usr/bin/env bash
# Marks this boot as good, so the boot menu stays hidden at the next one. GRUB clears the flag,
# orielos_boot_ok, at every boot and shows the menu when it finds it still cleared, which means
# the boot before never reached the desktop. The flag is in EFI/fedora/orielos-boot.env on the EFI
# system partition, next to GRUB: GRUB can't write to /boot, which is on the Btrfs root, but it can
# write to the partition's FAT file system. This script finds that partition on the disk that
# holds the root file system, mounts it, creates the file if it's missing and sets the flag.
# Run by orielos-boot-success.service, which the desktop session starts once Plasma is up.
# Runs as root.
set -Eeuo pipefail

ESP_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
ENV_PATH="EFI/fedora/orielos-boot.env"
MOUNT_DIR=""

log() {
    printf 'orielos-boot-success: %s\n' "$1"
}

cleanup() {
    if [[ -n "$MOUNT_DIR" ]]; then
        if mountpoint -q "$MOUNT_DIR"; then umount "$MOUNT_DIR" || true; fi
        rmdir "$MOUNT_DIR" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# The disk under the root file system, through any encryption or volume layers.
root_disk() {
    local source
    source="$(findmnt -no SOURCE /sysroot 2>/dev/null || findmnt -no SOURCE /)"
    # Btrfs subvolumes are shown as /dev/vda3[/root].
    source="${source%%\[*}"
    # -l lists the devices plainly; without it, -s draws a tree in front of the names.
    lsblk -lsnpo NAME,TYPE "$source" | awk '$2 == "disk" {print $1; exit}'
}

# Set the flag in the boot loader folder under <mount point>; returns 1 if GRUB isn't there.
mark() {
    local dir="$1"
    [[ -f "$dir/EFI/fedora/grub.cfg" ]] || return 1
    if [[ ! -f "$dir/$ENV_PATH" ]]; then
        grub2-editenv "$dir/$ENV_PATH" create
    fi
    grub2-editenv "$dir/$ENV_PATH" set orielos_boot_ok=1
    sync -f "$dir/$ENV_PATH"
}

disk="$(root_disk)"
[[ -n "$disk" ]] || {
    log "couldn't find the disk that holds the root file system"
    exit 1
}
mapfile -t partitions < <(lsblk -lnpo NAME,PARTTYPE "$disk" | awk -v t="$ESP_TYPE" 'tolower($2) == t {print $1}')
for partition in "${partitions[@]}"; do
    # Use the partition where it's mounted already; otherwise mount it here, in this service's own
    # mount namespace, for as long as it takes.
    target="$(findmnt -no TARGET --source "$partition" 2>/dev/null | head -n1)" || true
    if [[ -n "$target" ]]; then
        if mark "$target"; then
            log "marked this boot as good in $partition"
            exit 0
        fi
        continue
    fi
    MOUNT_DIR="$(mktemp -d /run/orielos-esp.XXXXXX)"
    mount -t vfat -o rw,nosuid,nodev,noexec,umask=0077 "$partition" "$MOUNT_DIR"
    if mark "$MOUNT_DIR"; then
        log "marked this boot as good in $partition"
        exit 0
    fi
    cleanup
    MOUNT_DIR=""
done
log "found no EFI system partition with GRUB on $disk; the boot menu can't follow how boots went"
exit 1
