#
# Gives Alt+F4 to OrielOS's Close or shut down KWin script, for accounts made before it: KWin's own
# Close Window keeps Alt+F4 in each user's kglobalshortcutsrc, so the script can't have it. Run once
# per user, before Plasma's shortcut service starts, by orielos-close-shortcut.service; a user who
# gave Close Window another shortcut keeps it. New accounts get the same from /etc/skel.
set -Eeuo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/orielos/close-shortcut"
[[ -e "$state" ]] && exit 0
mkdir -p -- "${state%/*}"

config="${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc"
current="$(kreadconfig6 --file "$config" --group kwin --key "Window Close" 2>/dev/null || true)"
if [[ -z "$current" || "${current%%,*}" == "Alt+F4" ]]; then
    kwriteconfig6 --file "$config" --group kwin --key "Window Close" "none,Alt+F4,Close Window"
fi
touch -- "$state"
