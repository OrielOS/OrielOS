#!/usr/bin/env bash
# Keeps OrielOS's parts of the boot menu's configuration up to date. bootupd writes GRUB's
# configuration, /boot/grub2/grub.cfg, from the image's /usr/lib/bootupd/grub2-static once, when
# OrielOS is installed, and never again: an update that changes OrielOS's GRUB snippets would
# otherwise not reach computers installed before it. At each start this replaces the sections
# OrielOS ships (configs.d/*orielos*.cfg, between bootupd's "### BEGIN <name> ###" and
# "### END <name> ###" lines) with the running version's, adds any that are missing in name order,
# and leaves the rest of the file as bootupd wrote it. The new file is checked with
# grub2-script-check and swapped in whole, so GRUB never reads a half-written one.
#
# Usage: boot-menu-config
# Tests set ORIELOS_GRUB_CFG and ORIELOS_GRUB_STATIC to use other files. Runs as root.
set -Eeuo pipefail

GRUB_CFG="${ORIELOS_GRUB_CFG:-/boot/grub2/grub.cfg}"
SNIPPETS="${ORIELOS_GRUB_STATIC:-/usr/lib/bootupd/grub2-static}/configs.d"
WORK=""
PART=""

# Copies each OrielOS section from its snippet in place of the file's own, and adds the missing
# ones before the first of bootupd's sections that sorts after them. Sections nested inside a
# snippet, such as "### BEGIN /etc/grub.d/01_users ###", are a snippet's own lines.
# shellcheck disable=SC2016
REWRITE='
function emit(name,    line, file) {
    file = dir "/" name
    print "### BEGIN " name " ###"
    while ((getline line < file) > 0) print line
    close(file)
    print "### END " name " ###"
}
BEGIN {
    n = split(ours, list, " ")
    for (i = 1; i <= n; i++) mine[list[i]] = 1
    m = split(missing, absent, " ")
}
skip != "" {
    if ($0 == "### END " skip " ###") skip = ""
    next
}
/^### BEGIN [^ \/]+\.cfg ###$/ {
    name = $3
    for (i = 1; i <= m; i++) {
        if (!(absent[i] in added) && absent[i] < name) {
            emit(absent[i])
            print ""
            added[absent[i]] = 1
        }
    }
    if (name in mine) {
        emit(name)
        skip = name
        next
    }
}
{ print }
END {
    for (i = 1; i <= m; i++) {
        if (!(absent[i] in added)) {
            print ""
            emit(absent[i])
        }
    }
}'

log() {
    printf 'orielos-boot-menu-config: %s\n' "$1" >&2
}

cleanup() {
    if [[ -n "$WORK" ]]; then rm -rf "$WORK"; fi
    if [[ -n "$PART" ]]; then rm -f "$PART"; fi
}

# /boot is read-only on most installations (a bind mount of the read-only /sysroot). The service
# runs with PrivateMounts=yes, so making it writable here doesn't reach the rest of the system.
make_writable() {
    local dir="$1" target
    [[ -w "$dir" ]] && return 0
    target="$(findmnt -no TARGET -T "$dir")"
    # A bind mount's own flag first, which leaves the file system's options alone.
    if ! mount -o remount,bind,rw "$target" 2>/dev/null && ! mount -o remount,rw "$target"; then
        log "couldn't make $target writable; keeping $GRUB_CFG as it is"
        exit 1
    fi
}

main() {
    case "${1:-}" in
        "") ;;
        --help | -h)
            sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            return 0
            ;;
        *)
            sed -n '11p' "${BASH_SOURCE[0]}" | sed 's/^# //' >&2
            exit 2
            ;;
    esac

    if [[ ! -f "$GRUB_CFG" ]] || ! head -n1 "$GRUB_CFG" | grep -q '^# Generated by bootupd'; then
        log "$GRUB_CFG wasn't written by bootupd; leaving the boot menu as it is"
        return 0
    fi

    local snippet name ours=() missing=()
    for snippet in "$SNIPPETS"/*orielos*.cfg; do
        [[ -f "$snippet" ]] || continue
        name="${snippet##*/}"
        ours+=("$name")
        grep -qxF "### BEGIN $name ###" "$GRUB_CFG" || missing+=("$name")
    done
    if [[ ${#ours[@]} -eq 0 ]]; then return 0; fi

    # The new file is put together outside /boot, so a start with nothing to change never writes there.
    trap cleanup EXIT
    WORK="$(mktemp -d)"
    awk -v dir="$SNIPPETS" -v ours="${ours[*]}" -v missing="${missing[*]}" "$REWRITE" "$GRUB_CFG" >"$WORK/grub.cfg"
    if cmp -s "$WORK/grub.cfg" "$GRUB_CFG"; then return 0; fi
    if ! grub2-script-check "$WORK/grub.cfg"; then
        log "the new boot menu configuration has errors; keeping $GRUB_CFG as it is"
        exit 1
    fi

    make_writable "$(dirname "$GRUB_CFG")"
    PART="$(mktemp "$GRUB_CFG.XXXXXX")"
    cp "$WORK/grub.cfg" "$PART"
    chmod --reference="$GRUB_CFG" "$PART"
    chcon --reference="$GRUB_CFG" "$PART" 2>/dev/null || true
    sync -f "$PART"
    mv -f "$PART" "$GRUB_CFG"
    PART=""
    sync -f "$GRUB_CFG"
    log "brought OrielOS's boot menu sections up to date: ${ours[*]}"
}

main "$@"
