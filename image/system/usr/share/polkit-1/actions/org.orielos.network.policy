<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
SPDX-FileCopyrightText: 2026 OrielOS contributors
SPDX-License-Identifier: GPL-3.0-or-later

What the network troubleshooter may run through pkexec. Restarting NetworkManager drops every
connection for a moment, so it needs an administrator; the password is kept for a few minutes, so
checking again and trying once more doesn't ask twice. Its other fixes run as the signed-in user,
whom NetworkManager's own rules already allow them.
-->
<policyconfig>
  <vendor>OrielOS</vendor>
  <vendor_url>https://github.com/OrielOS/OrielOS</vendor_url>
  <icon_name>network-wired</icon_name>

  <action id="org.orielos.network.restart">
    <description>Restart the network service</description>
    <message>Authentication is needed to restart the network service</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/orielos/restart-networking</annotate>
  </action>
</policyconfig>
