<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
SPDX-FileCopyrightText: 2026 OrielOS contributors
SPDX-License-Identifier: GPL-3.0-or-later

What the About settings page may ask rename-pc to do through pkexec: give this PC a new name. It
needs an administrator, as the name is the whole PC's; the password is kept for a few minutes, so
correcting a name straight away doesn't ask again.
-->
<policyconfig>
  <vendor>OrielOS</vendor>
  <vendor_url>https://github.com/OrielOS/OrielOS</vendor_url>
  <icon_name>computer</icon_name>

  <action id="org.orielos.rename-pc">
    <description>Rename this PC</description>
    <message>Authentication is needed to rename this PC</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/orielos/rename-pc</annotate>
  </action>
</policyconfig>
