<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
SPDX-FileCopyrightText: 2026 OrielOS contributors
SPDX-License-Identifier: GPL-3.0-or-later

What the Date & time settings page may run through pkexec. Turning setting the time zone
automatically on or off changes a system setting, so it needs an administrator, asked once for a
few minutes. Syncing the clock now only asks the network time servers sooner than chronyd would,
so anyone signed in at the PC may.
-->
<policyconfig>
  <vendor>OrielOS</vendor>
  <vendor_url>https://github.com/OrielOS/OrielOS</vendor_url>
  <icon_name>preferences-system-time</icon_name>

  <action id="org.orielos.time.auto-timezone">
    <description>Set the time zone automatically</description>
    <message>Authentication is needed to change how the time zone is set</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/orielos/auto-timezone</annotate>
  </action>

  <action id="org.orielos.time.sync">
    <description>Synchronise the clock now</description>
    <message>Authentication is needed to synchronise the clock</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/orielos/time-sync</annotate>
  </action>
</policyconfig>
