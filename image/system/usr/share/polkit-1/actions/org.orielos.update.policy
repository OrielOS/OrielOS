<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
SPDX-FileCopyrightText: 2026 OrielOS contributors
SPDX-License-Identifier: GPL-3.0-or-later

What the Update settings page may ask orielos-update to do through pkexec. Anyone using the
computer may pause, resume and check for updates, turn automatic app updates on or off, schedule
the restart that finishes an update and set the active hours and automatic restarts, without a
password; changing which builds the
computer gets, going back to the previous version and removing it need an administrator. pkexec
picks the action by the program and its first argument.
-->
<policyconfig>
  <vendor>OrielOS</vendor>
  <vendor_url>https://github.com/OrielOS/OrielOS</vendor_url>
  <icon_name>system-software-update</icon_name>

  <action id="org.orielos.update.pause">
    <description>Pause OrielOS updates</description>
    <message>Authentication is needed to pause OrielOS updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">pause</annotate>
  </action>

  <action id="org.orielos.update.resume">
    <description>Resume OrielOS updates</description>
    <message>Authentication is needed to resume OrielOS updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">resume</annotate>
  </action>

  <action id="org.orielos.update.app-updates">
    <description>Turn automatic updates of apps from the Store on or off</description>
    <message>Authentication is needed to change automatic app updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">app-updates</annotate>
  </action>

  <action id="org.orielos.update.check">
    <description>Check for OrielOS updates</description>
    <message>Authentication is needed to check for OrielOS updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">check-now</annotate>
  </action>

  <action id="org.orielos.update.channel">
    <description>Change which OrielOS builds this computer gets</description>
    <message>Authentication is needed to change which OrielOS builds this computer gets</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">channel</annotate>
  </action>

  <action id="org.orielos.update.rollback">
    <description>Go back to the previous OrielOS version</description>
    <message>Authentication is needed to go back to the previous OrielOS version</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>

  <action id="org.orielos.update.remove-previous">
    <description>Remove the previous OrielOS version</description>
    <message>Authentication is needed to remove the previous OrielOS version</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove-previous</annotate>
  </action>
  <action id="org.orielos.update.restart-at">
    <description>Schedule the restart that finishes an OrielOS update</description>
    <message>Authentication is needed to schedule the restart for an OrielOS update</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">restart-at</annotate>
  </action>

  <action id="org.orielos.update.active-hours">
    <description>Set the active hours for OrielOS updates</description>
    <message>Authentication is needed to set the active hours for OrielOS updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">active-hours</annotate>
  </action>

  <action id="org.orielos.update.auto-restart">
    <description>Turn automatic restarts for OrielOS updates on or off</description>
    <message>Authentication is needed to change automatic restarts for OrielOS updates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/orielos-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">auto-restart</annotate>
  </action>
</policyconfig>
