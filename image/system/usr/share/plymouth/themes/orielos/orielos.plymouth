#
# OrielOS's boot splash: the OrielOS logo in the middle of a black screen, so the boot continues
# from the firmware's screen without a flash of colour, with Plymouth's spinner below it. It uses
# Plymouth's two-step module, which shows "Shutting down" or "Restarting" over the spinner when
# the computer turns off. watermark.png is artwork/splash/orielos-splash-white.png; the spinner,
# password and keyboard images are copied from Plymouth's spinner theme at build time
# (image/build/90-finalise.sh).

[Plymouth Theme]
Name=OrielOS
Description=The OrielOS logo with a spinner
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/orielos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x5b6478
ProgressBarForegroundColor=0x3a66f0
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false
Title=Shutting down

[reboot]
UseEndAnimation=false
Title=Restarting

[updates]
SuppressMessages=true
# bootc reports no progress as it finishes an update, so the spinner shows instead of a bar.
ProgressBarShowPercentComplete=false
UseProgressBar=false
Title=Installing updates…
SubTitle=Don't turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading the system…
SubTitle=Don't turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading the firmware…
SubTitle=Don't turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting the system…
SubTitle=Don't turn off your computer
