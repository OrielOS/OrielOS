# System Monitor's Processes page: apps first, then every process, with CPU, memory, disk, network
# and GPU columns. OrielOS's start page (see /etc/xdg/systemmonitorrc).

[Face-1][Appearance]
chartFace=org.kde.ksysguard.applicationstable
showTitle=true
Title=Apps

[Face-1][org.kde.ksysguard.applicationstable][General]
showToolBar=false
sortedColumns=appName,usage,memory,ioCharactersActuallyReadRate,netInbound,gpu_usage
columnWidths=0.30,0.14,0.14,0.14,0.14,0.14
columnDisplay={"appName":"text","usage":"text","memory":"text","ioCharactersActuallyReadRate":"text","netInbound":"text","gpu_usage":"text"}
sortColumn=usage
sortDirection=1

[Face-2][Appearance]
chartFace=org.kde.ksysguard.processtable
showTitle=true
Title=Background processes

[Face-2][org.kde.ksysguard.processtable][General]
showToolBar=false
sortedColumns=name,usage,memory,ioCharactersActuallyReadRate,netInbound,gpu_usage
columnWidths=0.30,0.14,0.14,0.14,0.14,0.14
columnDisplay={"name":"text","usage":"text","memory":"text","ioCharactersActuallyReadRate":"text","netInbound":"text","gpu_usage":"text"}
sortColumn=usage
sortDirection=1

[page]
icon=view-process-system
margin=0
version=1
Title=Processes
actionsFace=Face-2

[page][row-0]
isTitle=false
name=row-0
Title=
heightMode=balanced

[page][row-0][column-0]
name=column-0
showBackground=false
noMargins=true

[page][row-0][column-0][section-0]
face=Face-1
isSeparator=false
name=section-0

[page][row-1]
isTitle=false
name=row-1
Title=
heightMode=balanced

[page][row-1][column-0]
name=column-0
showBackground=false
noMargins=true

[page][row-1][column-0][section-0]
face=Face-2
isSeparator=false
name=section-0
