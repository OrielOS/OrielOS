# System Monitor's Performance page: a large CPU graph, then memory, GPU, each disk and each network

[Face-1][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=CPU

[Face-1][Sensors]
highPrioritySensorIds=["cpu/all/usage"]
totalSensors=["cpu/all/usage"]

[Face-1][org.kde.ksysguard.linechart][General]
showLegend=true
lineChartFillOpacity=25
historyAmount=60
rangeAutoY=false
rangeFromY=0
rangeToY=100

[Face-2][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Memory

[Face-2][Sensors]
highPrioritySensorIds=["memory/physical/usedPercent"]
totalSensors=["memory/physical/used","memory/physical/total"]

[Face-2][org.kde.ksysguard.linechart][General]
showLegend=true
lineChartFillOpacity=25
historyAmount=60
rangeAutoY=false
rangeFromY=0
rangeToY=100

[Face-3][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=GPU

[Face-3][Sensors]
highPrioritySensorIds=["gpu/(?!all).*/usage"]
totalSensors=["gpu/all/usage"]

[Face-3][org.kde.ksysguard.linechart][General]
showLegend=true
lineChartFillOpacity=25
historyAmount=60
rangeAutoY=false
rangeFromY=0
rangeToY=100

[Face-4][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Disk

[Face-4][Sensors]
highPrioritySensorIds=["disk/all/read","disk/all/write"]

[Face-4][org.kde.ksysguard.linechart][General]
showLegend=true
lineChartFillOpacity=25
historyAmount=60

[Face-5][Appearance]
chartFace=org.kde.ksysguard.linechart
showTitle=true
Title=Network

[Face-5][Sensors]
highPrioritySensorIds=["network/all/download","network/all/upload"]

[Face-5][org.kde.ksysguard.linechart][General]
showLegend=true
lineChartFillOpacity=25
historyAmount=60

[page]
icon=speedometer
margin=2
version=1
Title=Performance
actionsFace=

[page][row-0]
isTitle=false
name=row-0
Title=
heightMode=balanced

[page][row-0][column-0]
name=column-0
showBackground=true
noMargins=false

[page][row-0][column-0][section-0]
face=Face-1
isSeparator=false
name=section-0

[page][row-1]
isTitle=false
name=row-1
Title=
heightMode=balanced

[page][row-1][column-0]
name=column-0
showBackground=true
noMargins=false

[page][row-1][column-0][section-0]
face=Face-2
isSeparator=false
name=section-0

[page][row-1][column-1]
name=column-1
showBackground=true
noMargins=false

[page][row-1][column-1][section-0]
face=Face-3
isSeparator=false
name=section-0

[page][row-2]
isTitle=false
name=row-2
Title=
heightMode=balanced

[page][row-2][column-0]
name=column-0
showBackground=true
noMargins=false

[page][row-2][column-0][section-0]
face=Face-4
isSeparator=false
name=section-0

[page][row-2][column-1]
name=column-1
showBackground=true
noMargins=false

[page][row-2][column-1][section-0]
face=Face-5
isSeparator=false
name=section-0
