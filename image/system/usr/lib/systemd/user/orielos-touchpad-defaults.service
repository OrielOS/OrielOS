[Unit]
Description=Give new touchpads Windows' tap to click and scrolling direction
Documentation=https://github.com/OrielOS/OrielOS/blob/main/docs/desktop.md
After=plasma-kwin_wayland.service

[Service]
# Each sign-in, for touchpads not seen before (see the script).
Type=oneshot
ExecStart=/usr/libexec/orielos/touchpad-defaults

[Install]
WantedBy=plasma-workspace.target
