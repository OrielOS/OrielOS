[Unit]
Description=Give this account OrielOS's Windows shortcuts, once
Documentation=https://github.com/ncjsvr/OrielOS/blob/main/docs/keyboard-shortcuts.md
Before=plasma-kglobalaccel.service

[Service]
# Runs at each sign-in until it has set the shortcuts once (see the script).
Type=oneshot
ExecStart=/usr/libexec/orielos/user-shortcuts

[Install]
WantedBy=plasma-workspace.target
