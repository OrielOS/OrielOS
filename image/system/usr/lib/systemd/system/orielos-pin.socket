[Unit]
Description=OrielOS's PIN service
Documentation=https://github.com/OrielOS/OrielOS/blob/main/docs/desktop.md

[Socket]
ListenStream=/run/orielos/pin.socket
# Anyone may ask; the service decides what each caller may do from its user ID.
SocketMode=0666
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
