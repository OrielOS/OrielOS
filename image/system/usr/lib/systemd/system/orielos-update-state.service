[Unit]
Description=Record this boot's OrielOS update state for the desktop
Documentation=https://github.com/OrielOS/OrielOS
# The desktop's update notifier reads the state at login, so it has to describe this boot by then.
# If the boot loader started the previous version because an update failed to reach the desktop
# twice, this is also when OrielOS keeps that version.
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/orielos-update refresh

[Install]
WantedBy=multi-user.target
