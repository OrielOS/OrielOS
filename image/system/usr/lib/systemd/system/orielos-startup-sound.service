[Unit]
Description=Play OrielOS's startup sound when the sign-in screen first appears
Documentation=https://github.com/OrielOS/OrielOS
# Once per boot, so signing out doesn't play it again. Turned off by creating
# /etc/orielos/startup-sound-off.
After=display-manager.service
ConditionPathExists=!/etc/orielos/startup-sound-off

[Service]
# Started, not waited for: the boot (graphical.target) never waits on the sound, which could hang
# where there is no sound card. It is stopped after a minute whatever happens.
Type=exec
# The sign-in screen runs as sddm, with its own sound server; play through that.
User=sddm
ExecStart=/usr/libexec/orielos/startup-sound
RuntimeMaxSec=60

[Install]
WantedBy=graphical.target
