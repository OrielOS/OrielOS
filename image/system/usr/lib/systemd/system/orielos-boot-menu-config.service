[Unit]
Description=Bring OrielOS's part of the boot menu up to date with this version
Documentation=https://github.com/OrielOS/OrielOS/blob/main/docs/updates.md
# bootupd writes the boot menu's configuration only when OrielOS is installed, so an update's
# changes to OrielOS's GRUB snippets reach it through this at the next start.
RequiresMountsFor=/boot
ConditionPathExists=/boot/grub2/grub.cfg

[Service]
Type=oneshot
ExecStart=/usr/libexec/orielos/boot-menu-config

[Install]
WantedBy=multi-user.target
