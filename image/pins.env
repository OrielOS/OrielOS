# Upstream inputs of the OS image, each pinned by digest so builds are reproducible.
# Sourced by tools/build-image.sh and tools/test-apps.sh, and rewritten by tools/update-pins.sh.
#
# To update the pins:
#   1. Run tools/update-pins.sh to see the current digests, then tools/update-pins.sh --write.
#   2. Review the kernel and NVIDIA versions it prints.
#   3. Build with tools/build-image.sh and boot-test the result.
#   4. Commit this file.

# Fedora release of the base image and the matching kernel packages.
FEDORA_MAJOR="44"

# Base bootc image.
BASE_IMAGE="quay.io/fedora/fedora-bootc:44@sha256:cb91f1cbe8bff6fcf9c142e3dda5b19be30a5c11d7fbfc10146128685cdf663d"

# Fedora CoreOS stable kernel, with signed common kernel modules.
AKMODS_IMAGE="ghcr.io/ublue-os/akmods:coreos-stable-44@sha256:ba1f561f547a49eb0108de21a5064fb5c9ed1822a94fa280ce2cd72e4bb68a3d"

# NVIDIA open kernel modules and driver, built for the same kernel as AKMODS_IMAGE.
AKMODS_NVIDIA_IMAGE="ghcr.io/ublue-os/akmods-nvidia-open:coreos-stable-44@sha256:eb1891aeae7a09a706b618cfb9fd63b4ee23eb339825bd4c16cebf78e56ecd9d"

# Fedora image that builds and tests OrielOS's own apps in the app-builder stage.
BUILDER_IMAGE="quay.io/fedora/fedora:44@sha256:8d2d82ab11e614324c42bc1e17322ea7829a8f48faea97645d2fa80d5f56f658"

# umu-launcher, which runs Windows programs through Proton for the .exe dialog. Fedora doesn't
# package it, so the image installs the Fedora RPM its project publishes with each release,
# checked against the SHA-256 GitHub shows for that release asset. tools/update-pins.sh doesn't
# touch it: to update, change the version in the URL (and the Fedora release, fcNN) and the digest.
UMU_LAUNCHER_RPM="https://github.com/Open-Wine-Components/umu-launcher/releases/download/1.4.4/umu-launcher-1.4.4.fc44.x86_64.rpm@sha256:f38dfe05c109a0ebeaecacad2ebe2e60fddc1fb2e50f7755023553ad256f8b32"
