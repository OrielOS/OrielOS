[Global]
IconName=system-software-update
Comment=OrielOS updates

[Event/updateReady]
Name=Update ready
Comment=An OrielOS update is ready and starts at the next restart
Action=Popup

[Event/goBackReady]
Name=Ready to go back
Comment=The previous OrielOS version starts at the next restart
Action=Popup

[Event/settingsFailed]
Name=Update settings not changed
Comment=Pausing updates, resuming them, checking for them, changing channel or going back didn't work
Action=Popup
