#
# The settings that applying this look-and-feel writes: OrielOS's light colour scheme, Breeze's
# widget style, Plasma theme, icons, cursors and window decorations, and the OrielOS wallpaper.
# Plasma also shows this wallpaper on any desktop that has none set. org.orielos.desktop.dark is the
# same in dark.

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=OrielOSLight

[kdeglobals][Icons]
Theme=breeze

[plasmarc][Theme]
name=orielos

[Wallpaper]
Image=OrielOS

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[ksplashrc][KSplash]
Theme=org.orielos.desktop
